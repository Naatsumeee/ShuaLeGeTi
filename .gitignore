*.apk
*.aab
*.aar
*.ap_
*.dex
*.class
*.hprof
hs_err_pid*
replay_pid*
output.json

# ---------- 本地环境与凭据（绝不入库）----------
local.properties
*.keystore
*.jks
.env
.env.*

